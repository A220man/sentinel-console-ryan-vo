# Sentinel Console Environment Configuration
# Copy to .env and fill in values

# Application
APP_NAME="Sentinel Console"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development

# Server
HOST=127.0.0.1
PORT=8000

# Database
# SQLite (development)
DATABASE_URL=sqlite:///./sentinel.db
# PostgreSQL (production)
# DATABASE_URL=postgresql://sentinel:password@db:5432/sentinel

# Security
SECRET_KEY=your-secret-key-here-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OIDC / Keycloak
OIDC_ENABLED=false
OIDC_ISSUER_URL=http://localhost:8080/realms/sentinel
OIDC_CLIENT_ID=sentinel-console
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=http://localhost:5173/callback
OIDC_SCOPES=openid profile email

# Keycloak Admin
KEYCLOAK_ADMIN_PASSWORD=admin

# LLM Configuration
LLM_API_KEY=your-llm-api-key
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30

# Demo Mode (localhost only)
DEMO_MODE=true
DEMO_USER_EMAIL=demo@sentinel.local
DEMO_USER_NAME=Demo User

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Frontend
VITE_API_URL=http://localhost:8000/api